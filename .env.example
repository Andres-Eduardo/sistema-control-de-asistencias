# ─────────────────────────────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno
# Copia este archivo como .env y completa con tus credenciales reales
# NUNCA subas el archivo .env a GitHub
# ─────────────────────────────────────────────────────────────────────

# URL de tu proyecto en Supabase
# Encuéntrala en: Supabase → Settings → API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave de servicio (service_role) — privilegios elevados, se salta RLS
# Encuéntrala en: Supabase → Settings → API Keys → Secret keys → default
# IMPORTANTE: usa la clave "service_role"/"secret", NUNCA la "anon"/"publishable".
# Supabase tiene dos formatos válidos según cuándo se creó tu proyecto:
#   - Formato nuevo:    sb_secret_...
#   - Formato legacy:   eyJ... (JWT, en "Legacy API Keys" si tu proyecto los tiene habilitados)
# Ambos formatos sirven — lo que importa es que sea el key de SERVICE_ROLE, no el anon.
# Si tus consultas no dan error pero siempre devuelven 0 resultados, casi seguro
# pusiste el key equivocado aquí (RLS bloquea todo silenciosamente con el anon key).
SUPABASE_SERVICE_KEY=sb_secret_... # o eyJ... si tu proyecto usa Legacy API Keys

# Clave pública anónima
# Encuéntrala en: Supabase → Settings → API Keys → Publishable key (o "anon public" en Legacy)
SUPABASE_ANON_KEY=sb_publishable_... # o eyJ... si tu proyecto usa Legacy API Keys

# Puerto del servidor (Render lo asigna automáticamente en producción)
PORT=3000

# Dominio permitido para CORS (en producción: tu URL de Render)
# En desarrollo local puedes dejarlo vacío o usar *
ALLOWED_ORIGIN=https://tu-app.onrender.com
